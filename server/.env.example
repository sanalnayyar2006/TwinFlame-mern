# Copy to server/.env and fill in. The server checks these at startup (src/config/env.ts).

# MongoDB connection string (Atlas or local: mongodb://127.0.0.1:27017/twinflame)
MONGODB_URI=

# 32+ random characters: openssl rand -hex 32. Changing it signs everyone out.
JWT_SECRET=

# Cloudinary (photo storage): https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Same value as the client's VITE_GOOGLE_CLIENT_ID. Required in production.
GOOGLE_CLIENT_ID=

# Production only: exact origin(s) allowed to call the API with cookies, comma-separated.
# Not needed when the server also serves the client (same origin).
CLIENT_URL=

# development | production
NODE_ENV=development
PORT=8000

# Optional
# LOG_LEVEL=info            # pino level; defaults to info in production, warn in development
# DEMO_MODE=true            # enables POST /api/auth/demo and the sample couple (resets daily)
# ALLOW_MOCK_GOOGLE=true    # local testing only: accepts dev_mock_<email>:<name> Google tokens; ignored in production
