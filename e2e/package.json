{
  "name": "e2e",
  "private": true,
  "scripts": {
    "build:client": "cd ../client && VITE_API_URL= VITE_GOOGLE_CLIENT_ID= VITE_DEMO_MODE=true pnpm build",
    "test": "pnpm build:client && playwright test --project=desktop --project=mobile",
    "test:only": "playwright test --project=desktop --project=mobile",
    "screenshots": "pnpm build:client && playwright test --project=screenshots"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
