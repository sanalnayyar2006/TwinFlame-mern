# Copy to client/.env. Vite only exposes variables that start with VITE_.

# Google Identity Services client ID (Google Cloud Console > Credentials > OAuth client)
VITE_GOOGLE_CLIENT_ID=

# Production builds only. Leave empty when the server serves the client (same origin).
# In development the Vite proxy forwards /api and /socket.io to localhost:8000.
VITE_API_URL=

# Shows "Enter as Ana / Ben" on the login page. The server needs DEMO_MODE=true too.
# VITE_DEMO_MODE=true
